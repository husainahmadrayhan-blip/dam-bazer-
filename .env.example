# Better Auth: use a strong random secret in production (32+ characters)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# PostgreSQL connection string. Use a managed PostgreSQL database for Vercel.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional OAuth providers. Configure redirect URLs in provider dashboards.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
